{
  "expo": {
    "name": "Cabine En Ligne",
    "slug": "cabine-en-ligne",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cabineenligne",
    "splash": {
      "backgroundColor": "#7B1FA2",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cabineenligne.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B1FA2",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.cabineenligne.app"
    },
    "web": {
      "favicon": "./public/icons/favicon-32.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}
