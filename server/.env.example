# ---------- Serveur ----------
PORT=4000
NODE_ENV=development

# Secret JWT (à changer en production !)
JWT_SECRET=change-me-strong-secret
JWT_EXPIRES_IN=7d

# ---------- Base de données ----------
# Laissez vide pour le mode fichier JSON (dev).
# Sur Render (PostgreSQL), cette variable est injectée automatiquement.
DATABASE_URL=postgres://user:password@host:5432/cabine

# ---------- Wave ----------
# "mock" = simulation locale (aucun appel réseau). "live" = API réelle.
WAVE_MODE=mock

# En mode live :
WAVE_BASE_URL=https://api.wave.com/v1
WAVE_API_KEY=wave_ci_prod_YhUNb9d...replace-me
# Secret de signature des webhooks (HMAC-SHA256)
WAVE_WEBHOOK_SECRET=wave-secret-mock

# Délai simulé (ms) avant déclenchement du webhook en mode mock
WAVE_MOCK_DELAY_MS=1800

# Indicateur pays (Côte d'Ivoire = +225, Sénégal = +221)
PHONE_PREFIX=+225
